# ==============================================================================
# Creators Kit - Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env or .env.local containing real secrets to Git.
# ==============================================================================

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/creators-kit?retryWrites=true&w=majority

# Authentication / JWT
JWT_SECRET=your_jwt_secret_key_here
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway (Live or Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ImageKit Image CDN
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# SMTP Mail Server (e.g., Hostinger, SendGrid, Gmail, or Ethereal for testing)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=465
SMTP_USER=support@yourdomain.com
SMTP_EMAIL=support@yourdomain.com
SMTP_PASS=your_smtp_password
FROM_EMAIL=support@yourdomain.com
